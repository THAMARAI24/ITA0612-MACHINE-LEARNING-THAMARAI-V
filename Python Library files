        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ============================================================\n",
        "# 1. CREATE DATASET INSIDE THE PROGRAM\n",
        "# ============================================================\n",
        "\n",
        "data = {\n",
        "    \"Name\": [\"Arun\", \"Priya\", \"Rahul\", \"Meena\", \"Kavin\",\n",
        "                 \"Divya\", \"Arun\", \"Suresh\", \"Anu\", \"Vijay\"],\n",
        "\n",
        "                         \"Age\": [20, 21, 20, None, 22, 21, 20, 23, None, 22],\n",
        "\n",
        "                                 \"Department\": [\"CSE\", \"AI&DS\", \"CSE\", \"ECE\", \"AI&DS\",\n",
        "                                                    \"CSE\", \"CSE\", \"ECE\", \"AI&DS\", \"ECE\"],\n",
        "\n",
        "                                                            \"Marks\": [85, 92, 78, 88, None, 95, 85, 72, 90, 80],\n",
        "\n",
        "                                                                    \"Attendance\": [90, 95, 80, 85, 88, None, 90, 75, 92, 82],\n",
        "\n",
        "                                                                            \"City\": [\"Chennai\", \"Chennai\", \"Madurai\", \"Chennai\", \"Coimbatore\",\n",
        "                                                                                         \"Chennai\", \"Chennai\", \"Madurai\", \"Coimbatore\", \"Chennai\"]\n",
        "                                                                                         }\n",
        "\n",
        "                                                                                         df = pd.DataFrame(data)\n",
        "\n",
        "                                                                                         print(\"\\nORIGINAL DATA:\")\n",
        "                                                                                         print(df)\n",
        "\n",
        "\n",
        "                                                                                         # ============================================================\n",
        "                                                                                         # 2. FILTERING DATA\n",
        "                                                                                         # ============================================================\n",
        "\n",
        "                                                                                         print(\"\\n--- FILTERING DATA ---\")\n",
        "\n",
        "                                                                                         # Students with marks greater than 85\n",
        "                                                                                         filtered_data = df[df[\"Marks\"] > 85]\n",
        "\n",
        "                                                                                         print(filtered_data)\n",
        "\n",
        "\n",
        "                                                                                         # ============================================================\n",
        "                                                                                         # 3. FILTERING DATA WITH MULTIPLE CONDITIONS\n",
        "                                                                                         # ============================================================\n",
        "\n",
        "                                                                                         print(\"\\n--- MULTIPLE CONDITIONS ---\")\n",
        "\n",
        "                                                                                         # AI&DS students AND marks greater than 85\n",
        "                                                                                         multiple_filter = df[\n",
        "                                                                                             (df[\"Department\"] == \"AI&DS\") &\n",
        "                                                                                                 (df[\"Marks\"] > 85)\n",
        "                                                                                                 ]\n",
        "\n",
        "                                                                                                 print(multiple_filter)\n",
        "\n",
        "\n",
        "                                                                                                 # ============================================================\n",
        "                                                                                                 # 4. SORTING DATA\n",
        "                                                                                                 # ============================================================\n",
        "\n",
        "                                                                                                 print(\"\\n--- SORTING DATA ---\")\n",
        "\n",
        "                                                                                                 # Sort according to Marks\n",
        "                                                                                                 sorted_data = df.sort_values(by=\"Marks\", ascending=False)\n",
        "\n",
        "                                                                                                 print(sorted_data)\n",
        "\n",
        "\n",
        "                                                                                                 # ============================================================\n",
        "                                                                                                 # 5. HANDLING MISSING VALUES\n",
        "                                                                                                 # ============================================================\n",
        "\n",
        "                                                                                                 print(\"\\n--- MISSING VALUES ---\")\n",
        "\n",
        "                                                                                                 # Detect missing values\n",
        "                                                                                                 print(\"\\nMissing value locations:\")\n",
        "                                                                                                 print(df.isnull())\n",
        "\n",
        "                                                                                                 # Count missing values\n",
        "                                                                                                 print(\"\\nCount of missing values:\")\n",
        "                                                                                                 print(df.isnull().sum())\n",
        "\n",
        "                                                                                                 # Remove rows containing missing values\n",
        "                                                                                                 df_removed = df.dropna()\n",
        "\n",
        "                                                                                                 print(\"\\nAfter removing rows with missing values:\")\n",
        "                                                                                                 print(df_removed)\n",
        "\n",
        "\n",
        "                                                                                                 # ============================================================\n",
        "                                                                                                 # 6. FILLING MISSING VALUES\n",
        "                                                                                                 # ============================================================\n",
        "\n",
        "                                                                                                 print(\"\\n--- FILLING MISSING VALUES ---\")\n",
        "\n",
        "                                                                                                 df_filled = df.copy()\n",
        "\n",
        "                                                                                                 # Fill numerical missing values with mean\n",
        "                                                                                                 df_filled[\"Age\"] = df_filled[\"Age\"].fillna(\n",
        "                                                                                                     df_filled[\"Age\"].mean()\n",
        "                                                                                                     )\n",
        "\n",
        "                                                                                                     df_filled[\"Marks\"] = df_filled[\"Marks\"].fillna(\n",
        "                                                                                                         df_filled[\"Marks\"].mean()\n",
        "                                                                                                         )\n",
        "\n",
        "                                                                                                         df_filled[\"Attendance\"] = df_filled[\"Attendance\"].fillna(\n",
        "                                                                                                             df_filled[\"Attendance\"].mean()\n",
        "                                                                                                             )\n",
        "\n",
        "                                                                                                             print(df_filled)\n",
        "\n",
        "\n",
        "                                                                                                             # ============================================================\n",
        "                                                                                                             # 7. REMOVING DUPLICATE DATA\n",
        "                                                                                                             # ============================================================\n",
        "\n",
        "                                                                                                             print(\"\\n--- DUPLICATE DATA ---\")\n",
        "\n",
        "                                                                                                             print(\"Number of duplicate rows:\")\n",
        "                                                                                                             print(df.duplicated().sum())\n",
        "\n",
        "                                                                                                             df_no_duplicates = df.drop_duplicates()\n",
        "\n",
        "                                                                                                             print(\"\\nAfter removing duplicates:\")\n",
        "                                                                                                             print(df_no_duplicates)\n",
        "\n",
        "\n",
        "                                                                                                             # ============================================================\n",
        "                                                                                                             # 8. AGGREGATION\n",
        "                                                                                                             # ============================================================\n",
        "\n",
        "                                                                                                             print(\"\\n--- AGGREGATION ---\")\n",
        "\n",
        "                                                                                                             # Average marks by department\n",
        "                                                                                                             department_average = df.groupby(\"Department\")[\"Marks\"].mean()\n",
        "\n",
        "                                                                                                             print(\"\\nAverage Marks by Department:\")\n",
        "                                                                                                             print(department_average)\n",
        "\n",
        "                                                                                                             # Maximum marks\n",
        "                                                                                                             print(\"\\nMaximum Marks:\")\n",
        "                                                                                                             print(df[\"Marks\"].max())\n",
        "\n",
        "                                                                                                             # Minimum marks\n",
        "                                                                                                             print(\"\\nMinimum Marks:\")\n",
        "                                                                                                             print(df[\"Marks\"].min())\n",
        "\n",
        "                                                                                                             # Total marks\n",
        "                                                                                                             print(\"\\nTotal Marks:\")\n",
        "                                                                                                             print(df[\"Marks\"].sum())\n",
        "\n",
        "                                                                                                             # Count students by department\n",
        "                                                                                                             print(\"\\nNumber of Students in Each Department:\")\n",
        "                                                                                                             print(df[\"Department\"].value_counts())\n",
        "\n",
        "\n",
        "                                                                                                             # ============================================================\n",
        "                                                                                                             # 9. WRITING DATA TO CSV\n",
        "                                                                                                             # ============================================================\n",
        "\n",
        "                                                                                                             print(\"\\n--- WRITING CSV FILE ---\")\n",
        "\n",
        "                                                                                                             df.to_csv(\"student_data.csv\", index=False)\n",
        "\n",
        "                                                                                                             print(\"Data successfully written to student_data.csv\")\n",
        "\n",
        "\n",
        "                                                                                                             # ============================================================\n",
        "                                                                                                             # 10. READING DATA FROM CSV\n",
        "                                                                                                             # ============================================================\n",
        "\n",
        "                                                                                                             print(\"\\n--- READING CSV FILE ---\")\n",
        "\n",
        "                                                                                                             new_df = pd.read_csv(\"student_data.csv\")\n",
        "\n",
        "                                                                                                             print(new_df)\n",
        "\n",
        "\n",
        "                                                                                                             # ============================================================\n",
        "                                                                                                             # 11. DATA VISUALIZATION\n",
        "                                                                                                             # ============================================================\n",
        "\n",
        "                                                                                                             # Remove missing values for visualization\n",
